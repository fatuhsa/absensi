# Copy this file to ".env" and fill in real values for local/production use.
# Never commit the real ".env" — it is gitignored.

# Node environment: "production" or "development"
NODE_ENV=production

# Port the backend HTTP server listens on
PORT=3001

# Timezone applied to all server-side date/time logic
TZ=Asia/Jakarta

# Secret used to sign JWT auth tokens. In production, set this to a long,
# high-entropy random string (e.g. `openssl rand -hex 48`). Required when
# NODE_ENV=production — the server will refuse to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins (e.g. "https://absensi.example.com").
# For local dev you can use "http://localhost:5173,http://localhost:3001".
# Leave empty to deny cross-origin requests in production.
CORS_ORIGIN=

# Radius (meters) of the default office location seeded into the DB.
SEED_LOCATION_RADIUS=100
